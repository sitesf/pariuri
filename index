<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NEWS UPDATE - Știri la zi</title>
    <style>
        /* CSS-ul de bază și variabilele pentru Light/Dark Mode */
        :root {
            --bg-color: #ffffff;
            --text-color: #111111;
            --secondary-text: #666666;
            --border-color: #eeeeee;
            --accent-color: #0056b3;
        }

        [data-theme="dark"] {
            --bg-color: #121212;
            --text-color: #f5f5f5;
            --secondary-text: #aaaaaa;
            --border-color: #333333;
            --accent-color: #4da3ff;
        }

        body {
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 0;
            transition: background-color 0.3s, color 0.3s;
        }

        header {
            border-bottom: 1px solid var(--border-color);
            padding: 20px 5%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
        }

        .logo {
            font-size: 24px;
            font-weight: 900;
            letter-spacing: -1px;
            text-transform: uppercase;
        }

        nav {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        nav a {
            text-decoration: none;
            color: var(--text-color);
            font-weight: 600;
            font-size: 14px;
            text-transform: uppercase;
        }

        nav a:hover {
            color: var(--accent-color);
        }

        .theme-toggle {
            background: none;
            border: 1px solid var(--border-color);
            color: var(--text-color);
            padding: 8px 12px;
            cursor: pointer;
            border-radius: 5px;
            font-weight: bold;
        }

        main {
            padding: 40px 5%;
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 40px;
        }

        @media (max-width: 768px) {
            main { grid-template-columns: 1fr; }
            header { flex-direction: column; text-align: center; }
        }

        .article-card {
            border-bottom: 1px solid var(--border-color);
            padding-bottom: 20px;
            margin-bottom: 20px;
        }

        .category-tag {
            color: var(--accent-color);
            font-size: 12px;
            font-weight: bold;
            text-transform: uppercase;
        }

        .article-title {
            font-size: 22px;
            margin: 10px 0;
            font-weight: 700;
        }

        .article-meta {
            font-size: 13px;
            color: var(--secondary-text);
        }

        .sidebar {
            border-left: 1px solid var(--border-color);
            padding-left: 40px;
        }

        .trending-item {
            margin-bottom: 15px;
            display: flex;
            gap: 15px;
        }

        .trending-number {
            font-size: 24px;
            font-weight: bold;
            color: var(--border-color);
        }

        .newsletter {
            background-color: var(--border-color);
            padding: 20px;
            border-radius: 8px;
            margin-top: 30px;
        }

        .newsletter input {
            width: 90%;
            padding: 10px;
            margin-top: 10px;
            border: 1px solid var(--secondary-text);
            border-radius: 4px;
        }

        .newsletter button {
            width: 95%;
            padding: 10px;
            margin-top: 10px;
            background-color: var(--text-color);
            color: var(--bg-color);
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
    </style>
</head>
<body>

    <header>
        <div class="logo">NEWS UPDATE</div>
        <nav>
            <a href="#">România</a>
            <a href="#">Lume</a>
            <a href="#">Politică</a>
            <a href="#">Business</a>
            <a href="#">AI & Tech</a>
            <a href="#">Sport</a>
            <a href="#">Monden</a>
        </nav>
        <button class="theme-toggle" id="themeToggle">🌙 Dark Mode</button>
    </header>

    <main>
        <div class="feed">
            <h2 style="margin-top:0;">Ultimele Articole</h2>
            
            <div class="article-card">
                <div class="category-tag">AI & Tech</div>
                <h3 class="article-title">Noul model de inteligență artificială poate programa singur aplicații complexe</h3>
                <div class="article-meta">Redacția · 27 aprilie 2026 · 4 min citire</div>
            </div>

            <div class="article-card">
                <div class="category-tag">România</div>
                <h3 class="article-title">Schimbări majore în infrastructura din București: Ce străzi devin exclusiv pietonale</h3>
                <div class="article-meta">Redacția · 27 aprilie 2026 · 3 min citire</div>
            </div>

            <div class="article-card">
                <div class="category-tag">Business</div>
                <h3 class="article-title">Bursa de la București atinge un nou maxim istoric după anunțurile din sectorul energetic</h3>
                <div class="article-meta">Redacția · 26 aprilie 2026 · 5 min citire</div>
            </div>
            
             <div class="article-card">
                <div class="category-tag">Monden</div>
                <h3 class="article-title">Cel mai așteptat festival al verii a publicat line-up-ul complet. Cine vine în România?</h3>
                <div class="article-meta">Redacția · 26 aprilie 2026 · 2 min citire</div>
            </div>
        </div>

        <aside class="sidebar">
            <h3 style="margin-top:0;">Trending Now</h3>
            
            <div class="trending-item">
                <div class="trending-number">01</div>
                <div>
                    <h4 style="margin:0; font-size: 15px;">Decizia surpriză luată astăzi în Parlament</h4>
                    <span class="article-meta">Politică</span>
                </div>
            </div>

            <div class="trending-item">
                <div class="trending-number">02</div>
                <div>
                    <h4 style="margin:0; font-size: 15px;">Echipa națională se pregătește pentru meciul decisiv</h4>
                    <span class="article-meta">Sport</span>
                </div>
            </div>

            <div class="trending-item">
                <div class="trending-number">03</div>
                <div>
                    <h4 style="margin:0; font-size: 15px;">Un nou start-up românesc atrage o finanțare de 5 milioane euro</h4>
                    <span class="article-meta">Lume / Business</span>
                </div>
            </div>

            <div class="newsletter">
                <h4 style="margin-top: 0;">Fii la curent</h4>
                <p style="font-size: 13px; color: var(--secondary-text);">Primește cele mai importante știri direct în inbox.</p>
                <input type="email" placeholder="Adresa ta de email">
                <button>Abonează-te</button>
            </div>
        </aside>
    </main>

    <footer style="text-align: center; padding: 20px; border-top: 1px solid var(--border-color); color: var(--secondary-text); font-size: 13px; margin-top: 40px;">
        © 2026 News Update. Toate drepturile rezervate.
    </footer>

    <script>
        const themeToggleBtn = document.getElementById('themeToggle');
        const currentTheme = localStorage.getItem('theme');

        if (currentTheme) {
            document.documentElement.setAttribute('data-theme', currentTheme);
            if (currentTheme === 'dark') {
                themeToggleBtn.textContent = '☀️ Light Mode';
            }
        }

        themeToggleBtn.addEventListener('click', function() {
            let theme = document.documentElement.getAttribute('data-theme');
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'light');
                localStorage.setItem('theme', 'light');
                themeToggleBtn.textContent = '🌙 Dark Mode';
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                themeToggleBtn.textContent = '☀️ Light Mode';
            }
        });
    </script>
</body>
</html>
